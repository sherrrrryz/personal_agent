{
  "color": {
    "$type": "color",
    "$description": "shadcn/ui's colour roles, light mode (the default). Dark values: color.dark.json. The values are shadcn/ui's stock `neutral` theme (D-43). To change a colour: point the role at another primitive of tokens/primitive/color.json (add the value there first), here and in color.dark.json, then npm run tokens:build.",
    "background": { "$value": "{color.neutral.0}" },
    "foreground": { "$value": "{color.neutral.950}" },
    "card": { "$value": "{color.neutral.0}" },
    "card-foreground": { "$value": "{color.neutral.950}" },
    "popover": { "$value": "{color.neutral.0}" },
    "popover-foreground": { "$value": "{color.neutral.950}" },
    "primary": { "$value": "{color.neutral.900}" },
    "primary-foreground": { "$value": "{color.neutral.50}" },
    "secondary": { "$value": "{color.neutral.100}" },
    "secondary-foreground": { "$value": "{color.neutral.900}" },
    "muted": { "$value": "{color.neutral.100}" },
    "muted-foreground": { "$value": "{color.neutral.500}" },
    "accent": { "$value": "{color.neutral.100}" },
    "accent-foreground": { "$value": "{color.neutral.900}" },
    "destructive": { "$value": "{color.red.600}" },
    "border": { "$value": "{color.neutral.200}" },
    "input": { "$value": "{color.neutral.200}" },
    "ring": { "$value": "{color.neutral.400}" },
    "chart-1": { "$value": "{color.neutral.300}" },
    "chart-2": { "$value": "{color.neutral.500}" },
    "chart-3": { "$value": "{color.neutral.600}" },
    "chart-4": { "$value": "{color.neutral.700}" },
    "chart-5": { "$value": "{color.neutral.800}" },
    "sidebar": { "$value": "{color.neutral.50}" },
    "sidebar-foreground": { "$value": "{color.neutral.950}" },
    "sidebar-primary": { "$value": "{color.neutral.900}" },
    "sidebar-primary-foreground": { "$value": "{color.neutral.50}" },
    "sidebar-accent": { "$value": "{color.neutral.100}" },
    "sidebar-accent-foreground": { "$value": "{color.neutral.900}" },
    "sidebar-border": { "$value": "{color.neutral.200}" },
    "sidebar-ring": { "$value": "{color.neutral.400}" },
    "surface-frosted": {
      "$value": "{color.white-alpha.70}",
      "$description": "Background of a surface of ours that floats or sticks over scrolling content (D-47): translucent, drawn with the backdrop blur surface.frosted.blur. Its text is the role the surface already carries (foreground, popover-foreground). Used only by the `surface-frosted` class in src/index.css."
    },
    "surface-frosted-shadow": {
      "$value": "{color.black-alpha.10}",
      "$description": "Colour of the small shadow around a frosted surface (D-47)."
    },
    "focus": {
      "$type": "string",
      "forced": {
        "$value": "{color.system.highlight}",
        "$description": "Outline colour of the focus indicator under forced-colors. One value, no mode."
      }
    }
  }
}
