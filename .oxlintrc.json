{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/components/ui",
              "@/components/ui/**",
              "**/components/ui",
              "**/components/ui/**"
            ],
            "message": "Kit files (src/components/ui/) are imported only from src/components/. Import the component from its family's index.ts — docs/design/COMPONENTS.md § Conventions."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
